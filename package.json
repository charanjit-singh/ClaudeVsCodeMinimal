{
  "name": "claude-launcher-minimal",
  "displayName": "Claude Agents",
  "description": "One status bar button that opens `claude agents` in the current project's folder, as a pinned terminal tab.",
  "version": "0.2.2",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeLauncher.openAgents",
        "title": "Claude: Open Agents",
        "icon": "$(sparkle)"
      },
      {
        "command": "claudeLauncher.newAgentsTab",
        "title": "Claude: New Agents Tab",
        "icon": "$(add)"
      }
    ]
  }
}
